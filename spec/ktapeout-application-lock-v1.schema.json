{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktapeout.org/tooling/ktapeout-application-lock-v1.schema.json",
  "title": "KTAPEOUT Application Lock V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_semver", "lock_hash", "recipe_hash", "composition_root", "components", "interface_binding_root", "effect_scope_root", "resource_policy_hash", "settlement_policy_hash", "dependency_root", "runtime_digest", "compiler_lock_digest", "network_policy_id", "created_at"],
  "properties": {
    "schema": {"const": "KTAPEOUT-APPLICATION-LOCK-V1"},
    "protocol_semver": {"const": "0.5.0"},
    "lock_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recipe_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "composition_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "components": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_id", "profile_id", "profile_semver", "profile_hash", "contract_hash", "effect_hash", "package_digest", "admission_level", "package_provenance"],
        "properties": {
          "component_id": {"type": "string", "maxLength": 128},
          "profile_id": {"type": "string", "maxLength": 128},
          "profile_semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "effect_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "admission_level": {"enum": ["REFERENCE", "IMPLEMENTED", "TESTNET_ADMITTED", "PRODUCTION_CANDIDATE"]},
          "package_provenance": {
            "type": "object", "additionalProperties": false,
            "required": ["publisher_id", "source_ref", "license_ref", "trust_tier"],
            "properties": {
              "publisher_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
              "license_ref": {"type": "string", "minLength": 1, "maxLength": 128},
              "trust_tier": {"enum": ["UNTRUSTED", "COMMUNITY", "VERIFIED", "CORE_MAINTAINER"]}
            }
          }
        }
      }
    },
    "interface_binding_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effect_scope_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "settlement_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler_lock_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network_policy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
